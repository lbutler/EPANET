; Direction of flow through a check valve decides reachability.
; J1 is fed from the reservoir. CV1 runs J1 -> J2, so J2 is supplied.
; CV2 runs J3 -> J1, so J3 cannot be reached through it and, with P3
; closed, has no supply at all.

[TITLE]
Check valve direction and reachability

[JUNCTIONS]
;ID    Elev    Demand
 J1    100     10
 J2    100     10
 J3    80      10

[RESERVOIRS]
;ID    Head
 R1    200

[PIPES]
;ID    Node1  Node2  Length  Diam  Rough  Mloss  Status
 P1    R1     J1     1000    12    100    0      OPEN
 CV1   J1     J2     1000    12    100    0      CV
 CV2   J3     J1     1000    12    100    0      CV
 P3    R1     J3     1000    12    100    0      CLOSED

[OPTIONS]
 Isolation Yes
 Units     GPM
 Headloss  H-W
 Trials    40
 Accuracy  0.001

[TIMES]
 Duration  0

[REPORT]
 Status    No
 Summary   No
 Page      0

[END]
